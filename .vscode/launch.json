{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch C++ Application",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/user_profile_app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/bin",
      "environment": [
        {
          "name": "CSRUNNER_LOG_LEVEL",
          "value": "DEBUG"
        },
        {
          "name": "CSRUNNER_LOG_FILE",
          "value": "${workspaceFolder}/build/bin/csrunner.log"
        },
        {
          "name": "CSRUNNER_DEBUG",
          "value": "1"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Stage Assets and Build"
    },
    {
      "name": ".NET Core Attach (C# Bridge)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}